# Combos
COMBO_ENABLE = yes

# Autocorrect (dictionary: ../../autocorrect_dictionary.txt)
AUTOCORRECT_ENABLE = yes

# Caps Word (hold D+K, or CW_TOGG on the Power layer)
CAPS_WORD_ENABLE = yes

# Key overrides (Shift+Backspace = Delete)
KEY_OVERRIDE_ENABLE = yes

# Layer Lock (QK_LLCK on the numbers and Power layers)
LAYER_LOCK_ENABLE = yes

# Keeper (keep-awake) mode, shared with the other keymaps
SRC += keeper.c
